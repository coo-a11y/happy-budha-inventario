{
  "name": "happybudha-inventario",
  "version": "4.0.0",
  "description": "Sistema de Inventario Happy Budha - Versión mejorada con UI moderna, filtros, dashboard y roles",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "migrate": "node scripts/migrate.js",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "integrity": "node scripts/database-integrity-check.js",
    "smoke": "node scripts/smoke-test.js",
    "map:preview": "node scripts/import-kml-map.js --dry-run",
    "test:kml": "node tests/kml-import.test.js",
    "map:db:dry": "node scripts/import-farm-map-db.js --dry-run",
    "map:db:verify": "node scripts/verify-farm-map-db.js",
    "test:farmdb": "node tests/farm-map-db.test.js",
    "prod:preflight": "node scripts/farm-os-production-preflight.js",
    "test:preflight": "node tests/production-preflight.test.js"
  },
  "keywords": [
    "inventario",
    "agrícola",
    "happy-budha"
  ],
  "author": "Sary Alarcón",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
